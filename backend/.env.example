# JOURNEX Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed

FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0

# Security Secrets (Generate a strong random string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key

# Database Connection URL:
# 1. SQLite (Default for local development):
# DATABASE_URL=sqlite:///instance/journex.db
#
# 2. MySQL (For production / cloud deployment):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/journex_db

# CORS Configuration (Comma separated origins)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
